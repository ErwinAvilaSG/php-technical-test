{
    "name": "tu_usuario/php-technical-test",
    "description": "Prueba técnica en PHP con Doctrine, DDD y Docker",
    "type": "project",
    "require": {
        "php": "^7.4 || ^8.0",
        "doctrine/orm": "^2.10",
        "symfony/console": "^5.0",
        "symfony/dotenv": "^5.0",
        "symfony/cache": "^5.4",
        "doctrine/annotations": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
